DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Banco usado pelos testes. NUNCA aponte para o mesmo banco do DATABASE_URL:
# os testes limpam todas as tabelas.
TEST_DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/centric_test

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Produção atrás de proxy/serverless (ver docs/DEPLOY.md)
TRUST_PROXY_HEADERS=false
DB_NULL_POOL=false
SQL_ECHO=false
RATE_LIMIT_ENABLED=true

# IA (a chave fica somente no backend)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
