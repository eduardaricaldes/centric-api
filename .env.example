DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Banco usado pelos testes. NUNCA aponte para o mesmo banco do DATABASE_URL:
# os testes limpam todas as tabelas.
TEST_DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/centric_test

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Produção atrás de proxy/serverless (ver docs/DEPLOY.md)
TRUST_PROXY_HEADERS=false
DB_NULL_POOL=false
SQL_ECHO=false
RATE_LIMIT_ENABLED=true

# IA (as chaves ficam somente no backend; todos os provedores no plano gratuito)
# Ordem da cadeia; quem não tiver chave é pulado.
AI_PROVIDER=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# Só modelos com sufixo :free.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_FALLBACK_TIMEOUT_SECONDS=20
